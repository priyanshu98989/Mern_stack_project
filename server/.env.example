# Server
NODE_ENV=development
PORT=5000
API_PREFIX=/api/v1
SERVER_URL=http://localhost:5000
CLIENT_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173
TRUST_PROXY=1

# Database
MONGODB_URI=mongodb://127.0.0.1:27017/certtrack
MONGO_MAX_POOL=10

# Auth
# Use unique 32+ character secrets in production.
JWT_ACCESS_SECRET=change-me-access
JWT_REFRESH_SECRET=change-me-refresh
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=7
BCRYPT_SALT_ROUNDS=12
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_MINUTES=15

# Cookies
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
COOKIE_DOMAIN=

# Uploads and limits
UPLOAD_DIR=./uploads
MAX_UPLOAD_BYTES=5242880
MAX_CERTIFICATES_PER_SEMESTER=20

# Verifiable Credentials / Signing
SIGNING_KEY_ID=ct-key-1
SIGNING_PRIVATE_KEY=
SIGNING_KEYS_DIR=./.keys
ISSUER_URL=http://localhost:5000

# AI
AI_ENABLED=true
AI_DAILY_LIMIT=50
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# Email (SMTP)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=CertTrack <no-reply@certtrack.local>

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:5000/api/v1/auth/google/callback
GOOGLE_ALLOWED_DOMAIN=

# Redis / Cron
REDIS_URL=
SLA_REMIND_DAYS=3
SLA_ESCALATE_DAYS=7
ENABLE_CRON=true

# App
INSTITUTION_NAME=CertTrack College
REQUIRED_CREDITS=20
LOG_LEVEL=info
APP_VERSION=1.0.0
